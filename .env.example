# Neon — 3 variables separadas
DATABASE_URL=jdbc:postgresql://ep-xxxx.neon.tech/neondb?sslmode=require
DATABASE_USERNAME=neondb_owner
DATABASE_PASSWORD=tu_password

PORT=8080
CORS_ALLOWED_ORIGINS=*

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_TOKEN_SECRET=cambia-este-secreto

# Imágenes de productos (GCS)
GCS_BUCKET_NAME=docs_distribuidora
GCS_UPLOAD_PREFIX=productos
GCS_PUBLIC_BASE_URL=https://storage.googleapis.com/docs_distribuidora

# Correo admin (Resend) — cotizaciones web
RESEND_API_KEY=re_xxxx
MAIL_FROM=noreply@distribuidoraguayaquil.com
MAIL_FROM_NAME=Distribuidora Guayaquil

# Facturación electrónica SRI (el backend firma y envía al SRI)
# SRI_AMBIENTE: 1 = pruebas, 2 = producción
SRI_AMBIENTE=1
# La firma .p12 se sube desde el admin (Facturación → Firma electrónica) y se guarda cifrada.
# Su clave NO se guarda: se escribe cada vez que se emite. Llave de cifrado opcional:
SRI_FIRMA_KEY=
# Primer número de factura a usar (si ya emitiste facturas antes, pon el siguiente)
SRI_SECUENCIAL_INICIAL=1
SRI_EMISOR_RUC=0953518057001
SRI_EMISOR_RAZON_SOCIAL=ASQUI MANZABA NICOLE KATHERINE
SRI_EMISOR_NOMBRE_COMERCIAL=ETERNITY EC
SRI_EMISOR_DIR_MATRIZ=Barrio: URB ASTURIAS Numero: SOLAR 32 Manzana: 13
SRI_EMISOR_DIR_ESTABLECIMIENTO=Calle: LA IOJA Numero: MZ 23 Interseccion: SL32
SRI_EMISOR_ESTAB=002
SRI_EMISOR_PTO=002
SRI_EMISOR_OBLIGADO_CONTABILIDAD=NO
# Solo si estás en el régimen RIMPE (emprendedor): CONTRIBUYENTE RÉGIMEN RIMPE
SRI_EMISOR_RIMPE=
# Logo del establecimiento en el PDF (URL pública, p. ej. del bucket)
SRI_EMISOR_LOGO_URL=
