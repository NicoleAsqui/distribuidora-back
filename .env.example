# Neon — 3 variables separadas
DATABASE_URL=jdbc:postgresql://ep-xxxx.neon.tech/neondb?sslmode=require
DATABASE_USERNAME=neondb_owner
DATABASE_PASSWORD=tu_password

PORT=8080
CORS_ALLOWED_ORIGINS=*

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_TOKEN_SECRET=cambia-este-secreto

# Imágenes de productos (GCS)
GCS_BUCKET_NAME=docs_distribuidora
GCS_UPLOAD_PREFIX=productos
GCS_PUBLIC_BASE_URL=https://storage.googleapis.com/docs_distribuidora

# Correo admin (Resend) — cotizaciones web
RESEND_API_KEY=re_xxxx
MAIL_FROM=noreply@distribuidoraguayaquil.com
MAIL_FROM_NAME=Distribuidora Guayaquil

# Facturación electrónica SRI (proxy → open-api-facturacion-sri)
# 1) Levanta la API Nest y autentícate (POST /auth/login) para obtener accessToken
# 2) Emisor + certificado P12 deben existir en esa API
SRI_API_URL=http://localhost:3001
SRI_API_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SRI_AMBIENTE=1
SRI_EMISOR_RUC=0999999999001
SRI_EMISOR_RAZON_SOCIAL=DISTRIBUIDORA GUAYAQUIL
SRI_EMISOR_NOMBRE_COMERCIAL=Distribuidora Guayaquil
SRI_EMISOR_DIR_MATRIZ=Guayaquil, Ecuador
SRI_EMISOR_DIR_ESTABLECIMIENTO=
SRI_EMISOR_ESTAB=001
SRI_EMISOR_PTO=001
